# Copier en .env : cp .env.example .env
DATABASE_URL=postgresql+psycopg://app:app@database/blog
# Signe les jetons JWT : 32 caractères minimum. Pour en générer une :
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-uniquement-remplacez-moi-par-une-vraie-cle-aleatoire

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=blog

# J4 : modèle de l'agent. "test" = modèle factice de Pydantic AI, sans réseau.
# Avec Claude : LLM_MODEL=anthropic:claude-opus-5-5 et la clé dans LLM_API_KEY.
LLM_MODEL=test
LLM_API_KEY=
